# Copiaza fisierul: cp .env.example .env  si completeaza valorile.
# Nu urca niciodata .env pe GitHub (e deja in .gitignore).
#
# Daca Wazuh/OPNsense ruleaza pe aceeasi masina cu Docker, foloseste
# host.docker.internal in loc de 127.0.0.1 (127.0.0.1 inseamna containerul insusi).

# Wazuh Server API (port 55000). User dedicat cu rolul 'readonly'.
WAZUH_URL=https://host.docker.internal:55000
WAZUH_USER=comply
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false

# Wazuh Indexer (port 9200) pentru alerte si vulnerabilitati. Optional.
# User cu acces doar de citire la indecsii wazuh-*.
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# Praguri pentru verificari
SCA_MIN_SCORE=70
FIM_MAX_AGE_HOURS=48
ALERTS_WINDOW_DAYS=30

# OPNsense API: System > Access > Users > API keys
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_VERIFY_TLS=false
