# Copiaza fisierul: cp .env.example .env  si completeaza valorile.
# Nu urca niciodata .env pe GitHub (e deja in .gitignore).

# Wazuh API (port 55000). Recomandat: user dedicat, doar citire.
WAZUH_URL=https://192.168.1.10:55000
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false

# OPNsense API: System > Access > Users > API keys
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_VERIFY_TLS=false
