# Copy this file: cp .env.example .env  and fill in the values.
# Never commit .env to git (it is already in .gitignore).
#
# If Wazuh/OPNsense run on the same machine as Docker, use host.docker.internal
# instead of 127.0.0.1 (inside the container 127.0.0.1 is the container itself).
#
# Same machine AND the Wazuh Indexer listens only on 127.0.0.1 (all-in-one install)?
# Uncomment the next line and use https://127.0.0.1:... in both Wazuh URLs below.
# COMPOSE_FILE=docker-compose.yml:docker-compose.hostnet.yml

# Wazuh Server API (port 55000). Dedicated user with the 'readonly' role.
WAZUH_URL=https://host.docker.internal:55000
WAZUH_USER=comply
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false

# Wazuh Indexer (port 9200) for alerts and vulnerabilities. Optional.
# User with read-only access to the wazuh-* indices.
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# HTTPS. true = serve HTTPS with a self-signed certificate created on first start
# (or put your own cert.pem/key.pem in the data volume under /data/tls).
COMPLY_TLS=false
COMPLY_TLS_HOSTNAME=1cyber-comply

# Login security
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Organisation name printed on PDF reports
ORG_NAME=Your organisation

# Automatic collection interval in hours (0 = disabled, use the buttons only)
COLLECT_INTERVAL_HOURS=24

# Check thresholds
SCA_MIN_SCORE=70
FIM_MAX_AGE_HOURS=48
ALERTS_WINDOW_DAYS=30

# OPNsense API: System > Access > Users > API keys
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_VERIFY_TLS=false
