#!/bin/sh
# 'remove' keeps your settings and data. 'purge' deletes them permanently.
set -e
if [ "$1" = "purge" ]; then
  rm -f /opt/1cyber-comply/.env
  if command -v docker >/dev/null 2>&1; then
    docker volume rm 1cyber-comply_comply-data >/dev/null 2>&1 || true
    docker image rm 1cyber-comply:latest >/dev/null 2>&1 || true
  fi
  rm -rf /opt/1cyber-comply
fi
exit 0
